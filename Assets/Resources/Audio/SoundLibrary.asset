    volume: 1
    pitchVariation: 0.05
  - name: MusicCafeDay
    sound: 101
    plays: At the cafe, morning and afternoon.
    clips:
    - {fileID: 8300000, guid: 0cdbe0beb8f7f844bb3f704048f98fe2, type: 3}
    volume: 1
    pitchVariation: 0.05
  - name: MusicCafeEvening
    sound: 102
    plays: At the cafe once the day's foraging is done.
    clips:
    - {fileID: 8300000, guid: 0cdbe0beb8f7f844bb3f704048f98fe2, type: 3}
    volume: 1
    pitchVariation: 0.05
