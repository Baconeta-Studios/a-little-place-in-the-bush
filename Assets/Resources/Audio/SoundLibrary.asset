    volume: 1
    pitchVariation: 0.05
  - name: AmbientBushDay
    sound: 200
    plays: 'Under the music all day, on the Music slider: birds, wind in the trees.'
    clips: []
    volume: 1
    pitchVariation: 0.05
  - name: AmbientBushNight
    sound: 201
    plays: 'Under the music at night, on the Music slider: crickets, moreporks.'
    clips: []
    volume: 1
    pitchVariation: 0.05
  - name: UiTap
    sound: 300
    plays: Tapping any button.
    clips:
    - {fileID: 8300000, guid: 39958de82bc84c64bc180fec9c249a5e, type: 3}
    volume: 1
    pitchVariation: 0.05
  - name: UiBack
