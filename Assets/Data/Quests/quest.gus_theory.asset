  id: quest.gus_theory
  displayName: Gus has a theory
  description: Gus, a gecko who only comes out at night, needs samples. He says 5 crickets. He won't say why.
  giver: {fileID: 11400000, guid: 03143a456f4f67747ba1bf100c63d7d0, type: 2}
  isMain: 0
