  id: quest.gus_lights
  displayName: Visitors from the sky
  description: Gus needs something that glows, to signal the Visitors. Find a glowworm on a night trip, and have lanterns out to light their way.
  giver: {fileID: 11400000, guid: 03143a456f4f67747ba1bf100c63d7d0, type: 2}
