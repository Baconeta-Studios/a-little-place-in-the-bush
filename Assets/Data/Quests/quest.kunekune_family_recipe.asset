  id: quest.kunekune_family_recipe
  displayName: Nana's secret
  description: 'You found a muddy recipe scribble on a trip with Kunekune. Show it to Kunekune: it smells like home.'
  giver: {fileID: 11400000, guid: 2c36384265e346b4c861e8f313ad8a83, type: 2}
