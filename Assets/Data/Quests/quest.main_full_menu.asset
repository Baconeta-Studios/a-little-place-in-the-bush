  id: quest.main_full_menu
  displayName: A proper menu
  description: A proper cafe has a proper menu. Get 3 dishes on the board at once and close up for the day. Upgrades on the menu board add more menu slots.
  giver: {fileID: 11400000, guid: f21f6627390bcb64886542154e0fbfe8, type: 2}
  isMain: 1
