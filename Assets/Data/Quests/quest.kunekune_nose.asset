  id: quest.kunekune_nose
  displayName: Follow your nose
  description: Kunekune smells mushrooms on you and wants in. Find 3 mushrooms on foraging trips, and Kunekune will come along.
  giver: {fileID: 11400000, guid: 2c36384265e346b4c861e8f313ad8a83, type: 2}
