  id: quest.main_gather
  displayName: Leaves for the salad
  description: 'A leaf salad needs 3 leaves. Take the path at the side of the cafe into the bush. On the forage screen, choose Greens under Look out for: you find more of whatever you look out for.'
  giver: {fileID: 11400000, guid: 5d5225a0f63986044a63dd642f50f449, type: 2}
