  id: quest.main_goodbye_ruru
  displayName: Ruru moves on
  description: Ruru reckons you can manage without her now. Have a word before she goes.
  giver: {fileID: 11400000, guid: 5d5225a0f63986044a63dd642f50f449, type: 2}
  isMain: 1
