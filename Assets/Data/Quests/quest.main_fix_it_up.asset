  id: quest.main_fix_it_up
  displayName: Somewhere worth sitting
  description: "K\u014Dwhai won't eat here until it's got enough seats and looks like somebody cares. Help the visitors to your cafe: they might have furniture to spare."
  giver: {fileID: 11400000, guid: f21f6627390bcb64886542154e0fbfe8, type: 2}
