  id: quest.spider_moths
  displayName: A light for the moths
  description: Spider wants the moths to come to the cafe. Have 2 lanterns out at the cafe, and close up for the night.
  giver: {fileID: 11400000, guid: f2bec46a0fa805245915c0c60dd2b0e1, type: 2}
