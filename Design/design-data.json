  "npcs": [
    {
      "id": "npc.ruru",
      "name": "Ruru",
      "species": "Ruru (morepork)",
      "description": "The old cafe owner. Wise, sleepy by day, and missing her famous recipe."
    },
    {
      "id": "npc.weka",
      "name": "Weka",
      "species": "Weka",
      "description": "Cheeky, always hanging around the cafe, and steals anything shiny."
    },
    {
      "id": "npc.snail",
      "name": "Snail",
      "species": "Snail",
      "description": "Slurps up giant worms and will spend all day in the cafe if worm pie is on the menu."
    },
    {
      "id": "npc.weta",
      "name": "Wētā",
      "species": "Wētā",
      "description": "Nocturnal, lives in a hollow tree trunk that badly needs fixing."
    }
  ],
  "quests": [
    {
      "id": "quest.main_welcome",
      "title": "A cafe of my own",
      "giver": "npc.ruru",
      "isMain": true,
      "prerequisites": [],
      "summary": "Ruru wants to see you cook something before she trusts you with the cafe.",
      "objectives": [
        {
          "type": "CookRecipe",
          "target": "recipe.leaf_salad",
          "qty": 1
        }
      ],
      "rewards": [
        {
          "type": "Coins",
          "target": "",
          "qty": 20
        },
        {
          "type": "UnlockPerk",
          "target": "perk.keen_eye",
          "qty": 1
        }
      ],
      "dialogue": {
        "offer": "So you're the one taking over my old cafe? Show me you can make a simple leaf salad.",
        "active": "A leaf salad. Three handfuls of leaves. You can manage that.",
        "ready": "Ah, that smells right. You'll do.",
        "done": "The cafe's in good claws."
      }
    },
    {
      "id": "quest.main_lost_recipe",
      "title": "The lost recipe",
      "giver": "npc.ruru",
      "isMain": true,
      "prerequisites": [
        "quest.main_welcome"
      ],
      "summary": "Ruru's famous kawakawa scroll recipe was torn into four scraps and scattered. Find all four and bring them to her.",
      "objectives": [
        {
          "type": "DeliverItems",
          "target": "item.recipe_scrap_1",
          "qty": 1
        },
        {
          "type": "DeliverItems",
          "target": "item.recipe_scrap_2",
          "qty": 1
        },
        {
          "type": "DeliverItems",
          "target": "item.recipe_scrap_3",
          "qty": 1
        },
        {
          "type": "DeliverItems",
          "target": "item.recipe_scrap_4",
          "qty": 1
        }
      ],
      "rewards": [
        {
          "type": "UnlockRecipe",
          "target": "recipe.kawakawa_scroll",
          "qty": 1
        },
        {
          "type": "Coins",
          "target": "",
          "qty": 50
        }
      ],
      "dialogue": {
        "offer": "My kawakawa scroll recipe... the wind took it, and it tore into four. One blew into the bush. I'd bet that weka has another.",
        "active": "Any luck with the scraps? Try the bush, and ask around the neighbours.",
        "ready": "All four! Let me piece them together...",
        "done": "The kawakawa scroll is yours now. Make the village proud."
      }
    },
    {
      "id": "quest.side_weka_trade",
      "title": "A fair trade",
      "giver": "npc.weka",
      "isMain": false,
      "prerequisites": [
        "quest.main_welcome"
      ],
      "summary": "Weka has a recipe scrap and will swap it for a shiny button.",
      "objectives": [
        {
          "type": "DeliverItems",
          "target": "item.shiny_button",
          "qty": 1
        }
      ],
      "rewards": [
        {
          "type": "Item",
          "target": "item.recipe_scrap_2",
          "qty": 1
        }
      ],
      "dialogue": {
        "offer": "Paper? Oh, THIS paper. It's not stolen, it's... found. One shiny button and it's yours.",
        "active": "A button. A shiny one.",
        "ready": "Ooh, shiny! Deal. Take your paper.",
        "done": "Got anything else shiny? No? Hmph."
      }
    },
    {
      "id": "quest.side_snail_hungry",
      "title": "A very hungry snail",
      "giver": "npc.snail",
      "isMain": false,
      "prerequisites": [
        "quest.main_welcome"
      ],
      "summary": "Snail will share something it found if you cook two worm pies.",
      "objectives": [
        {
          "type": "CookRecipe",
          "target": "recipe.worm_pie",
          "qty": 2
        }
      ],
      "rewards": [
        {
          "type": "Item",
          "target": "item.recipe_scrap_3",
          "qty": 1
        },
        {
          "type": "Coins",
          "target": "",
          "qty": 10
        },
        {
          "type": "UnlockCompanion",
          "target": "companion.kunekune",
          "qty": 1
        }
      ],
      "dialogue": {
        "offer": "Worm... pie...? Two, please. I found some old paper you can have.",
        "active": "Still... hungry...",
        "ready": "Mmmmm. Here. The paper. Slowly. And my friend the kunekune pig wants to forage with you.",
        "done": "Same time tomorrow?"
      }
    },
    {
      "id": "quest.side_weta_repairs",
      "title": "Hollow home",
      "giver": "npc.weta",
      "isMain": false,
      "prerequisites": [
        "quest.main_welcome"
      ],
      "summary": "Wētā's hollow tree trunk is falling apart. Bring 4 bark and 2 silk to patch it up.",
      "objectives": [
        {
          "type": "DeliverItems",
          "target": "item.bark",
          "qty": 4
        },
        {
          "type": "DeliverItems",
          "target": "item.silk",
          "qty": 2
        }
      ],
      "rewards": [
        {
          "type": "Item",
          "target": "item.recipe_scrap_4",
          "qty": 1
        },
        {
          "type": "UnlockCompanion",
          "target": "companion.spider",
          "qty": 1
        }
      ],
      "dialogue": {
        "offer": "*rubs hind legs* My trunk is full of holes. Four bark and two silk would fix it. I'll give you a scrap I found inside.",
        "active": "Four bark, two silk. Kea is good at finding bark.",
        "ready": "Snug again! Here, take this scrap. And my friend Spider wants to go foraging with you.",
        "done": "Come by at night. I'm awake then."
      }
    }
  ]
